#include <iostream>
using namespace std;

int main()
{
    int arr[2][3] = {
        {10, 20, 30},
        {40, 50, 60}
    };

    cout << "Elements of 2D array are:" << endl;

    // Traversing rows and columns
    for(int i = 0; i < 2; i++)        // row loop
    {
        for(int j = 0; j < 3; j++)    // column loop
        {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
