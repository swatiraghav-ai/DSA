#include<iostream>
using namespace std ;
int main (){
    int n ;
    cout << "emter size of an array ";
    cin >> n;
    int arr[n];
    cout << "enter array elemant ";
    for (int i =0 ; i<n;i++){
        cin>> arr[i];
    }
    int target;
    cout << "enetr target element ";
    cin >> target;
    int start =1, end =n, mid , ans;
    mid = start + (end -start)/2;

    while(start <= end){
        if(arr[mid *mid]==target){
            ans = mid ;
            break ;
        }
        else if (arr[mid * mid]< target){
            ans = mid;
            start=mid+1;
        }
        else{
            end = mid -1;
    
        }
    } 
    return ans;
}